+    ; --- adaptive pre-sample (n == 0 only; run density is a frame property) ---
+    ; usable-run extension probability over up to 32 cells of the first row:
+    ; among usable cells, the fraction whose right neighbour is identical.
+    ; Below 0.5 -> dense; route those to the per-cell path (xe = x+1), which
+    ; beats the run-find machinery on short-run content. Conservative by
+    ; design: the per-row signal is noisy and a false 'dense' on long-run
+    ; content is far costlier than a miss.
+    test            nd, nd
+    jnz .skip_sample
+    jmp .skip_sample                         ; DIAG disable sample
+    xor           r12d, r12d                 ; usable bitmask
+    mov           refd, 1
+.us_build:
+    cmp     byte [n7q+refq], 0
+    je .us_skip
+    bts           r12d, refd                 ; bit k set iff ref2ref[k-1] != 0
+.us_skip:
+    inc           refd
+    cmp           refd, 8
+    jl .us_build
+    mov           r13d, xendid
+    sub           r13d, xstartid
+    sub           r13d, 2                     ; pairs, less read-ahead slack
+    jle .skip_sample
+    cmp           r13d, 32
+    jle .w_ok
+    mov           r13d, 32                    ; W = min(pairs, 32)
+.w_ok:
+    lea           refq, [xstartiq+xstartiq*4] ; xstarti * 5
+    lea        rp_refq, [offq+refq]           ; p = &r[ystart][xstarti]
+    mov dword [rsp+0x04], 0                   ; use_n
+    mov dword [rsp+0x10], 0                   ; use_ext
+.samp:
+    movzx         refd, byte [rp_refq+4]      ; cell ref
+    bt            r12d, refd
+    jnc .samp_next
+    inc dword [rsp+0x04]                      ; use_n++
+    mov       refsignd, [rp_refq]             ; mv
+    cmp       refsignd, [rp_refq+5]
+    jne .samp_next
+    mov       refsignb, [rp_refq+4]           ; ref
+    cmp       refsignb, [rp_refq+9]
+    jne .samp_next
+    inc dword [rsp+0x10]                      ; use_ext++
+.samp_next:
+    add        rp_refq, 5
+    dec           r13d
+    jg .samp
+    mov           refd, [rsp+0x10]
+    add           refd, refd                  ; use_ext * 2
+    cmp           refd, [rsp+0x04]            ; vs use_n
+    setl          refb
+    movzx         refd, refb
+    mov     [rsp+0x4c], refd                   ; dense iff use_ext/use_n < 0.5
